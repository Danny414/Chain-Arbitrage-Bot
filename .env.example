# BSC Whale Alert Bot — Environment Variables
# Copy this file to .env and fill in your actual values

# Telegram Bot Credentials (from @BotFather)
BSC_TG_TOKEN=your_telegram_bot_token_here
BSC_TG_CHAT_ID=your_telegram_chat_id_here

# Optional: Base Chain Bot (if running BASE bot as well)
# BASE_TG_TOKEN=your_base_bot_token_here
# BASE_TG_CHAT_ID=your_base_chat_id_here

# Optional: Solana Bot
# TELEGRAM_BOT_TOKEN=your_solana_bot_token_here
# TELEGRAM_CHAT_ID=your_solana_chat_id_here
